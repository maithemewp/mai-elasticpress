# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.AppleDouble
.LSOverride

# Coverage directory used by tools like istanbul
coverage

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Output of `npm pack`
*.tgz

# Output of `wp-scripts plugin-zip`
*.zip

# dotenv environment variables file
.env

# vendor/ is committed (prod-only, --no-dev) so plugin updates apply without a
# composer build on the server. Allowlist: ignore everything under vendor/ except
# the autoloader, composer's own files, and each committed production package.
/vendor/*
!/vendor/autoload.php
!/vendor/composer/
!/vendor/elasticsearch/
!/vendor/ezimuel/
!/vendor/psr/
!/vendor/react/
!/vendor/yahnis-elsts/
# Composer's runtime manifest regenerates with the current git ref (churns after
# every commit) and is never read at runtime on the deployed tree, so don't track
# it. installed.json is the stable, committed record of what's installed.
/vendor/composer/installed.php

# deployable-guard's generated pre-commit hook (dev-only; regenerated on install).
.githooks/
